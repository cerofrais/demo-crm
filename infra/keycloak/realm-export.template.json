{
  "realm": "tre-wellness",
  "enabled": true,
  "displayName": "Trē Wellness",
  "sslRequired": "none",
  "loginTheme": "tre",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "crm-admin", "description": "Full access; Keycloak admin; DPDP compliance" },
      { "name": "crm-doctor", "description": "Health profiles, therapy plans; no pipeline" },
      { "name": "crm-manager", "description": "Full pipeline, staff performance, packages, referrals; no health data" },
      { "name": "crm-reception", "description": "Own leads, messaging, tasks" },
      { "name": "crm-sales", "description": "Own leads up to Booking Confirmed, then handed off to Reception" },
      { "name": "crm-staff", "description": "Read-only assigned tasks and guest names" },
      { "name": "crm-viewer", "description": "Read-only across almost the whole app; no Health Records" }
    ]
  },
  "clients": [
    {
      "clientId": "tre-crm",
      "name": "Trē Wellness CRM",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://harsha-pc-ubuntu:3000/*",
        "http://harsha-pc-ubuntu:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": ["http://localhost:3000", "http://harsha-pc-ubuntu:3000", "+"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"]
    }
  ],
  "users": [
    {
      "username": "service-account-tre-crm",
      "enabled": true,
      "serviceAccountClientId": "tre-crm",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    },
    {
      "username": "admin",
      "email": "admin@tre.test",
      "firstName": "Aaradhya",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${SEED_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["crm-admin"]
    },
    {
      "username": "doctor",
      "email": "doctor@tre.test",
      "firstName": "Devi",
      "lastName": "Doctor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${SEED_DOCTOR_PASSWORD}", "temporary": false }],
      "realmRoles": ["crm-doctor"]
    },
    {
      "username": "manager",
      "email": "manager@tre.test",
      "firstName": "Manish",
      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${SEED_MANAGER_PASSWORD}", "temporary": false }],
      "realmRoles": ["crm-manager"]
    },
    {
      "username": "reception",
      "email": "reception@tre.test",
      "firstName": "Riya",
      "lastName": "Reception",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${SEED_RECEPTION_PASSWORD}", "temporary": false }],
      "realmRoles": ["crm-reception"]
    },
    {
      "username": "staff",
      "email": "staff@tre.test",
      "firstName": "Sanya",
      "lastName": "Staff",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${SEED_STAFF_PASSWORD}", "temporary": false }],
      "realmRoles": ["crm-staff"]
    }
  ]
}
